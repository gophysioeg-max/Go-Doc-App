# Copy to rag/.env and fill in.

# Postgres with pgvector. Local (docker compose up -d) or your Supabase project's
# direct connection string (Project Settings > Database).
DATABASE_URL=postgresql://godoc:godoc@localhost:5432/godoc_rag

# Embeddings: bge-m3 (local, free, good Arabic) | voyage (API) | hash (tests only)
GODOC_EMBEDDER=bge-m3
# VOYAGE_API_KEY=
# GODOC_VOYAGE_MODEL=voyage-3.5

# Answers
ANTHROPIC_API_KEY=
GODOC_ANSWER_MODEL=claude-opus-5-5
# Best-hit cosine similarity below this = "no source". Tune on real questions.
GODOC_MIN_SIMILARITY=0.35
